# Application Settings
PROJECT_NAME="LevelUp"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api"

# CORS Configuration (JSON array of allowed origins)
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (SQLite for local MVP development)
DATABASE_URL="sqlite:///./levelup.db"

# JWT Authentication Configuration
JWT_SECRET_KEY="levelup-dev-secret-key-change-in-production-minimum-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
